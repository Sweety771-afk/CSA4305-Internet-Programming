/* Reset */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f4f4f4;
}

/* Header */

header{
    background:#1e88e5;
    color:white;
    text-align:center;
    padding:20px;
}

/* Navigation */

nav{
    display:flex;
    justify-content:center;
    background:#333;
    gap:20px;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

nav a:hover{
    color:yellow;
}

/* Main */

.container{
    width:90%;
    margin:auto;
    padding:30px 0;
}

.content h2{
    margin-bottom:15px;
}

.content p{
    margin-bottom:30px;
}

/* Product Cards */

.products{
    display:flex;
    justify-content:space-between;
    gap:20px;
    flex-wrap:wrap;
}

.card{
    background:white;
    flex:1;
    min-width:220px;
    padding:20px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.2);
}

.card:hover{
    transform:scale(1.05);
    transition:0.3s;
}

/* Footer */

footer{
    background:#1e88e5;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

/* ===================== */
/* Tablet */
/* ===================== */

@media(max-width:768px){

nav{
    flex-wrap:wrap;
}

.products{
    justify-content:center;
}

.card{
    flex:45%;
}

}

/* ===================== */
/* Mobile */
/* ===================== */

@media(max-width:480px){

header h1{
    font-size:24px;
}

nav{
    flex-direction:column;
    align-items:center;
}

.products{
    flex-direction:column;
}

.card{
    width:100%;
}

}
