<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Retail Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Retail Store</h1>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">Products</a>
        <a href="#">Offers</a>
        <a href="#">Contact</a>
    </nav>

    <main class="container">

        <section class="content">
            <h2>Welcome</h2>
            <p>
                Welcome to our retail website. This webpage is fully responsive
                and adjusts automatically for desktop, tablet, and mobile devices.
            </p>

            <div class="products">
                <div class="card">
                    <h3>Product 1</h3>
                    <p>Smart Watch</p>
                </div>

                <div class="card">
                    <h3>Product 2</h3>
                    <p>Headphones</p>
                </div>

                <div class="card">
                    <h3>Product 3</h3>
                    <p>Laptop</p>
                </div>

                <div class="card">
                    <h3>Product 4</h3>
                    <p>Mobile Phone</p>
                </div>
            </div>
        </section>

    </main>

    <footer>
        <p>© 2026 Retail Store | Responsive Layout Design</p>
    </footer>

</body>
</html>
